# Salin file ini menjadi .env lalu sesuaikan nilainya:  cp .env.example .env
# PERINGATAN: variabel berawalan VITE_ akan masuk ke bundle JavaScript
# dan TERLIHAT oleh siapa saja. Jangan isi password / API key di sini.
VITE_APP_NAME=Daftar Tugas Kuliah
VITE_APP_VERSION=1.0.0

# Contoh rahasia (TANPA awalan VITE_ -> tidak dikirim ke browser).
# Hanya boleh dipakai oleh server/backend, bukan kode di folder src.
# API_SECRET_KEY=isi_di_file_env_lokal_saja
